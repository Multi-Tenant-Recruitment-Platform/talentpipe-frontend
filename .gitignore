# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Per-machine Docker Compose settings (e.g. a different backend port).
# Compose loads this automatically; it must never reach the shared branch.
docker-compose.override.yml

# Test coverage output (regenerated by `npm run test:coverage`)
coverage

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local AI/agent tooling — machine-local, never push to shared branches.
# NOTE: .github/workflows, CODEOWNERS and pull_request_template.md are real
# project files and stay tracked — only the agent/skill/hook folders are ignored.
.claude/
.github/agents/
.github/hooks/
.github/skills/
.impeccable/

# Environment files — never commit real credentials or machine-local values.
.env
.env.*
!.env.example
