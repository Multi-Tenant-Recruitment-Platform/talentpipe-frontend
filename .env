VITE_API_BASE_URL=/api/v1

# Docker Compose runtime override.
# Apache already owns host port 8080 on this machine, and a native
# `mvnw spring-boot:run` backend is already up on 8081 (see .env.local) — so
# nginx proxies straight to that instead of spinning up a second backend.
BACKEND_ORIGIN=http://host.docker.internal:8081
