# ---------------------------------------------------------------------------
# Production SPA server.
#
# Rendered at container start: the official nginx image runs envsubst over
# every /etc/nginx/templates/*.template file. Only variables that are actually
# EXPORTED in the environment are substituted, so nginx's own $uri / $host /
# $scheme survive untouched — do not "escape" them.
#
# ${BACKEND_ORIGIN} is the one substitution, which is why the API target is a
# run-time knob rather than something baked into the image at build time.
# ---------------------------------------------------------------------------
server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Container healthcheck target. Answered by nginx itself, so it stays green
  # even when the backend is down — this reports "the SPA is being served",
  # which is exactly what this container is responsible for.
  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # API traffic is proxied rather than called cross-origin, which makes the
  # browser see one origin and removes CORS from the picture entirely. This
  # mirrors the Vite dev proxy (vite.config.ts), so dev and Docker behave the
  # same and `VITE_API_BASE_URL` can stay the relative '/api/v1'.
  #
  # `^~` is load-bearing: it stops nginx from evaluating the static-asset regex
  # below. Without it, an API path that happened to end in .css/.js/.svg would
  # match that regex instead and be served as a missing file.
  location ^~ /api/ {
    proxy_pass ${BACKEND_ORIGIN};

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Invitation, verification and reset mails are sent inline on the request
    # thread, so those endpoints can outlast the 60s default.
    proxy_connect_timeout 10s;
    proxy_send_timeout    75s;
    proxy_read_timeout    75s;
  }

  # Vite emits content-hashed filenames, so these can be cached indefinitely.
  location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf)$ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # SPA fallback. Required for deep links that arrive from email —
  # /accept-invite?token=…, /verify-email?token=…, /reset-password?token=… —
  # and for a hard refresh on any /dashboard/* route.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
